# Template for ~/webroot/01-jojoaddison/ankobra-web/.env on the server.
#
# Copy to `.env`, fill in every generated value, and `chmod 600` it — it holds the database password
# and the signing key for every admin session. It is never committed; only this template is.
#
# `deploy.sh --bootstrap` generates the secrets with `openssl rand` running ON THE SERVER, so they
# never exist on the deploying machine, in its shell history, or on the wire. Filling this in by hand
# is the fallback, not the normal path.

# --- Image ---------------------------------------------------------------------------------------

# TAG is set by deploy.sh to the deployed commit SHA. `latest` is a convenience for a manual deploy
# and should not be what production normally runs on, because it makes "what is deployed"
# unanswerable after the fact.
#
# REGISTRY is the deployment channel, and deploy.sh rewrites this line to match `--channel`:
#
#   docker.jojoaddison.net   the private registry; images built locally by deploy/build.sh
#   ghcr.io/<owner>          images built by .github/workflows/publish.yml on a GitHub runner
#
# It is a namespace, not a bare host, because that is how GHCR addresses images. compose.yml
# interpolates "${REGISTRY}/ankobra-web:${TAG}" either way. A GHCR package is private by default, so
# unless it has been made public the server needs `docker login ghcr.io` with a PAT carrying
# read:packages, or `./start` fails at the pull.
REGISTRY=docker.jojoaddison.net
TAG=latest

# --- Secrets (all three are required; the app refuses to start without them) -----------------------

# Postgres password for this stack's database.
#   openssl rand -base64 24
POSTGRES_PASSWORD=

# JWT signing key. HS512 needs at least 64 bytes of key material.
#   openssl rand -base64 64 | tr -d '\n'
# Rotating this invalidates every issued token, which signs the operator out — the correct response
# to a suspected leak. There is no fallback: the sample key lives in a dev-only profile, so production
# supplies its own or fails to start, and failing to start is the safe outcome.
JWT_BASE64_SECRET=

# The admin password, applied to the seeded account at every boot by AdminPasswordInitializer. Unset,
# the account keeps generator-jhipster's committed `admin`/`admin`.
#   openssl rand -base64 24
ANKOBRA_ADMIN_PASSWORD=

# --- Public identity ------------------------------------------------------------------------------

# The address the public actually reaches — the apex jojoaddison.net (www is served by the same
# nginx block). Used for CORS and as the base URL in account emails, so a wrong value here breaks
# cross-origin calls and sends links to a host that does not exist.
PUBLIC_URL=https://jojoaddison.net

# Loopback port the app container publishes; nginx proxies to it. Change only if it collides with
# another app on this host.
APP_PORT=8090

# --- Mail (optional) ------------------------------------------------------------------------------

# Leave SMTP_HOST empty to run without mail. The marketing contact form only writes a Lead row, so
# mail is not on the critical path; it is used for JHipster account emails (password reset, etc.).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
MAIL_FROM=noreply@jojoaddison.net

# --- Observability / tracing ----------------------------------------------------------------------

# Metrics are always on: the app exposes Prometheus at /management/prometheus (ADMIN-scoped) and is
# scrapeable on the container network. Distributed tracing is ON by default on this host and exports
# to the shared OTLP collector (otel-collector on the `monitoring` network → Tempo). These lines only
# need setting to override the compose defaults (disable, resample, or aim at another collector):
#   OTEL_TRACING_ENABLED=false                                   # turn tracing off
#   OTEL_TRACE_SAMPLING=0.1                                      # head sampling 0.0–1.0 (0.1 = 10%)
#   OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318/v1/traces
# Left unset here so compose.yml's defaults (enabled, 100% sampling, otel-collector) apply.
